# ---------------------------------------------------------------- 运行期数据
# 数据库、导出文件、证件照、密钥都在 data/ 下，绝不能进仓库
data/
*.db
*.db-shm
*.db-wal
secret.key
settings.json
# ⚠ gitignore 不支持行尾注释：`pat # 说明` 会被整串当成文件名，规则静默失效
.gh_device.json

# 本单位部署覆盖（校名预填 / 学院 / 部门），**绝不进公开仓库**
# 开源构建用 build_exe.py --github，不会带它
local_defaults.json
exports/
photos/

# ---------------------------------------------------------------- 构建产物
# exe 走 GitHub Release，不随仓库版本化；build/ 是 PyInstaller 的中间目录
dist/
build/
*.spec
!tools/*.spec

# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---------------------------------------------------------------- 前端 / 工具
node_modules/
.pytest_cache/
.DS_Store
Thumbs.db

# ---------------------------------------------------------------- 日志
*.log
